{%- comment -%}
  sections/bundles.liquid
  #bundles — "One box. Every room." pricing tier cards.

  Unlike Combos (specific curated products), a bundle tier here is a generic
  pricing plan ("pick any 2 products for ₹349") — no fixed product list, so
  this doesn't need a metaobject. It maps cleanly to section blocks, same
  pattern as Hero's pricing tiers: a merchant can add/remove/reorder tiers,
  edit copy and price, and pick which products illustrate the tier's icon
  strip, all from the theme editor.

  Bullet features use a textarea (one feature per line) rather than a
  repeated text field per bullet — Shopify has no native "list of short
  text" block setting, and a textarea keeps the editor UI simple for a
  merchant adding a 4th bullet later.
{%- endcomment -%}

<section class="sec" id="bundles" data-scene="3" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}
    {%- if tier_blocks.size > 0 -%}
      <div class="tiers">
        {%- for block in tier_blocks -%}
          {%- liquid
            assign products = block.settings.tierpix_products
            assign is_five = false
            if products.size >= 5
              assign is_five = true
            endif
            assign save_amt = block.settings.compare_at_price | minus: block.settings.price
            assign per_product = block.settings.price | divided_by: block.settings.qty
          -%}
          <article class="glass tier{% if block.settings.featured %} best{% endif %} rv" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
            {%- if products.size > 0 -%}
              <div class="tierpix{% if is_five %} five{% endif %}" aria-hidden="true">
                {%- for product in products -%}
                  {%- if product.featured_media -%}
                    {{ product.featured_media | image_url: width: 150 | image_tag: loading: 'lazy', class: 'pimg', alt: '' }}
                  {%- else -%}
                    <span class="pimg pimg-fallback">{% render 'icon', name: 'leaf' %}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
            <div class="price">
              {{ block.settings.price | times: 100 | money }}
              {%- if block.settings.compare_at_price > block.settings.price -%}
                <s>{{ block.settings.compare_at_price | times: 100 | money }}</s>
              {%- endif -%}
            </div>
            <p class="body-s" style="font-size:12px">Flat {{ per_product | times: 100 | money }} per product</p>
            {%- if block.settings.features != blank -%}
              <ul>
                {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                {%- for line in feature_lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}
                    <li>{% render 'icon', name: 'check' %}{{ trimmed }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <a class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
              {{ block.settings.button_label | default: 'Build this box' }}
              {%- if block.settings.featured %} {% render 'icon', name: 'arrow-right' %}{%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="body-s" style="text-align:center">Add tier blocks to preview the bundle pricing cards.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "product_list", "id": "tierpix_products", "label": "Icon strip products", "limit": 5 },
        { "type": "number", "id": "qty", "label": "Number of products in this tier", "default": 2 },
        { "type": "number", "id": "price", "label": "Price (₹)", "default": 349 },
        { "type": "number", "id": "compare_at_price", "label": "Compare-at price (₹)", "default": 598 },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "Pick any two products\nFree shipping across India" },
        { "type": "checkbox", "id": "featured", "label": "Highlight as most popular", "default": false },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to #shop" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "qty": 2, "price": 349, "compare_at_price": 598, "features": "Pick any two products\nFree shipping across India" } },
        { "type": "tier", "settings": { "tag": "Most popular", "qty": 3, "price": 499, "compare_at_price": 897, "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India", "featured": true, "button_label": "Build this box" } },
        { "type": "tier", "settings": { "tag": "Whole home", "qty": 5, "price": 799, "compare_at_price": 1495, "features": "Pick any five products\nEvery room in one order\nFree shipping across India" } }
      ]
    }
  ]
}
{% endschema %}
