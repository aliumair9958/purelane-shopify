{%- comment -%}
  sections/shop-grid.liquid
  #shop — "Loved by 30,000 homes" bestsellers grid.

  PRODUCTION CHANGES FROM THE PROTOTYPE:
  - The prototype hardcoded 4 products with typed-in names, star ratings, and
    review counts. Production pulls a real Shopify collection so a merchant
    manages this by adding/removing products from a collection, not editing
    template code.
  - Each card's corner badge ("Best seller" / "New" / "Top rated") is a
    per-block override, since that's marketing copy, not platform data —
    nothing in Shopify natively models "badge text on a product."
  - Star rating count is read from product metafields (namespace/key set to
    match what most review apps, e.g. Judge.me/Loox, write to). If a product
    has no rating yet, the rating line is omitted rather than faked.
{%- endcomment -%}

<section class="sec" id="shop" data-scene="3" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>{% render 'icon', name: 'leaf' %}<i></i>
      </div>
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="shelf">
        {%- assign blocks_by_handle = section.blocks | where: 'type', 'badge_override' -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- liquid
            assign badge_label = blank
            for block in blocks_by_handle
              if block.settings.product.handle == product.handle
                assign badge_label = block.settings.label
              endif
            endfor
            assign delay_index = forloop.index0 | modulo: 4
          -%}
          {%- case delay_index -%}
            {%- when 0 -%} {%- assign reveal = 'rv' -%}
            {%- when 1 -%} {%- assign reveal = 'rv rv-d1' -%}
            {%- when 2 -%} {%- assign reveal = 'rv rv-d2' -%}
            {%- when 3 -%} {%- assign reveal = 'rv rv-d3' -%}
          {%- endcase -%}
          {%- render 'product-card', product: product, badge_label: badge_label, reveal_class: reveal -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="body-s" style="text-align:center">Select a collection with products in the section settings to preview this grid.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection to display" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "blocks": [
    {
      "type": "badge_override",
      "name": "Product badge",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label", "label": "Badge text", "default": "Best seller" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Shop grid" }
  ]
}
{% endschema %}
