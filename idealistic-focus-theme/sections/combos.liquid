{%- comment -%}
  sections/combos.liquid
  #combos — "Best selling combos" horizontal swipe rail.

  DATA MODEL DECISION (see build notes for full reasoning):
  A "combo" is a curated set of specific products bundled at a fixed price
  with marketing copy per product ("Cuts grease instantly"). Nothing native
  in Shopify models this — it's not a collection (no fixed price/copy) and
  not a discount (no curated product list + narrative). Built as a
  `combo` metaobject with fields:
    title            (single line text)
    tagline_products  (list of product references, in display order)
    tagline_text      (list of single line text, same order/length as products
                       — the "Cuts grease instantly" style micro-copy per item)
    price             (money)
    compare_at_price  (money)
    flag_label        (single line text, optional — "Most popular" / "Best value")
    featured          (boolean — true = gets the accent border treatment,
                       matches the prototype's `.hero-combo` class)
    description       (multi-line text — the "Includes: ..." paragraph)

  Merchants manage combos entirely from Content > Metaobjects, no template
  edits needed to add a 6th combo or retire one.
{%- endcomment -%}

<section class="sec" id="combos" data-scene="3" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i>{% render 'icon', name: 'leaf' %}<i></i></div>
      {%- if section.settings.subheading != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign combo_blocks = section.blocks | where: 'type', 'combo' -%}
    {%- if combo_blocks.size > 0 -%}
      <div class="comborail rv" tabindex="0" role="region" aria-label="Combo products, scrollable, use arrow keys or swipe" data-combo-rail>
        {%- for block in combo_blocks -%}
          {%- assign combo = block.settings.combo_ref -%}
          {%- if combo != blank -%}
            <article class="glass combo{% if combo.featured.value %} hero-combo{% endif %}" {{ block.shopify_attributes }}>
              <div class="tray">
                {%- assign save_amt = combo.compare_at_price.value | minus: combo.price.value -%}
                <span class="save">You save {{ save_amt | money }}</span>
                {%- if combo.flag_label.value != blank -%}
                  <span class="flag">{{ combo.flag_label.value }}</span>
                {%- endif -%}
                <div class="stack">
                  {%- for product in combo.tagline_products.value -%}
                    {%- assign tag_text = combo.tagline_text.value[forloop.index0] -%}
                    <span class="it">
                      {%- if product.featured_media -%}
                        {{ product.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', class: 'pimg', alt: product.title }}
                      {%- else -%}
                        <span class="tile">{% render 'icon', name: 'leaf' %}</span>
                      {%- endif -%}
                      <span>{{ tag_text | default: product.title }}</span>
                    </span>
                    {%- unless forloop.last -%}<span class="plus" aria-hidden="true">+</span>{%- endunless -%}
                  {%- endfor -%}
                </div>
              </div>
              <div class="body">
                <h3>{{ combo.title.value }}</h3>
                <div class="cnt">{{ combo.tagline_products.value.size }} products</div>
                {%- if combo.description.value != blank -%}
                  <p class="inc">{{ combo.description.value }}</p>
                {%- endif -%}
                <div class="prow">
                  <strong>{{ combo.price.value | money }}</strong>
                  <s>{{ combo.compare_at_price.value | money }}</s>
                  <em>Save {{ save_amt | money }}</em>
                </div>
                <div class="fine">Inclusive of all taxes · COD available</div>
                <a class="btn {% if combo.featured.value %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ section.settings.bundle_link | default: '#bundles' }}">
                  Shop bundle
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="swipecue" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}Swipe for more combos</div>
      {%- if section.settings.rail_note != blank -%}
        <p class="railnote">{{ section.settings.rail_note }}</p>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="body-s" style="text-align:center">Add a "Combo" block and pick a combo metaobject entry to preview this rail.</p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'purelane-combos.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Combos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "rail_note", "label": "Note below rail", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." },
    { "type": "url", "id": "bundle_link", "label": "\"Shop bundle\" link", "info": "Defaults to #bundles" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "metaobject", "id": "combo_ref", "label": "Combo", "metaobject_type": "combo" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Combos" }
  ]
}
{% endschema %}
