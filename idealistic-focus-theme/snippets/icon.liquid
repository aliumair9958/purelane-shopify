{%- comment -%}
  Renders one of the prototype's hand-coded SVGs by name.
  Usage: {% render 'icon', name: 'leaf', class: 'bi' %}
  Original file redrew these inline 15+ times; centralising them means a
  design tweak (stroke width, path) happens in one place, and keeps section
  files focused on structure instead of path data.
{%- endcomment -%}
{%- liquid
  assign cls = class | default: ''
-%}
{%- case name -%}
  {%- when 'leaf' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
  {%- when 'shield-check' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
  {%- when 'no-chemical' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
  {%- when 'check' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
  {%- when 'star' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.7 14.9 9l6.9.6-5.2 4.6 1.6 6.8L12 17.7 5.8 21l1.6-6.8L2.2 9.6 9.1 9 12 2.7Z"/></svg>
{%- endcase -%}
